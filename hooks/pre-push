#!/usr/bin/env bash
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0

bash scripts/rules.sh < /dev/null || exit 1

# Measured against the branch the remote being pushed to calls its own, not a name taken for granted.
remote=${1:-origin}
# A push straight to a URL names no remote, and is measured as it always was.
git remote get-url "$remote" > /dev/null 2>&1 || remote=origin
main=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2> /dev/null || echo "$remote/main")

nothing=0000000000000000000000000000000000000000
status=0
while read -r ref mine where theirs; do
  [ -n "${mine:-}" ] || continue
  [ "$mine" != "$nothing" ] || continue
  # The name it takes on the remote, which is the one everybody sees.
  case ${where:-} in
    refs/heads/*) bash scripts/branches.sh "${where#refs/heads/}" || status=1 ;;
  esac
  # A tag is the last moment to notice the version it names has nothing to tell whoever installs it.
  case ${ref:-} in
    refs/tags/v*)
      bash scripts/news.sh "${ref#refs/tags/v}" || status=1
      bash scripts/docs.sh "${ref#refs/tags/v}" || status=1
      continue
      ;;
  esac
  if base=$(git merge-base "$mine" "$main" 2> /dev/null) && [ -n "$base" ]; then
    range="$base..$mine"
  elif [ "${theirs:-$nothing}" != "$nothing" ]; then
    range="$theirs..$mine"
  else
    echo "!  $main is not here, so the subjects were not looked at"
    continue
  fi
  bash scripts/commits.sh "$range" || status=1
done

exit $status
