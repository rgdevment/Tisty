#!/usr/bin/env bash
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 0
status=0

# What is about to be committed, not what the working tree happens to hold beside it.
staged=$(mktemp -d)
trap 'rm -rf "$staged"' EXIT
git checkout-index --all --prefix="$staged/" || {
  echo "x  the staged tree could not be written out, so nothing was looked at"
  exit 1
}

# The copy has no .git of its own, and a rule that asks git what is tracked must hear the index.
index=$(realpath "${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}")
GIT_DIR="$(git rev-parse --absolute-git-dir)" GIT_INDEX_FILE="$index" \
  bash "$staged/scripts/rules.sh" < /dev/null || status=1
bash "$staged/scripts/branches.sh" "$(git rev-parse --abbrev-ref HEAD)" || status=1

quietly() {
  local said
  said=$(eval "$1" 2>&1) || {
    printf '%s\n' "$said"
    printf 'x  %s\n' "$2"
    status=1
  }
}

if command -v cargo > /dev/null; then
  quietly "cd \"$staged\" && cargo fmt --all --check" "cargo fmt --all would change files"
  # The fuzz targets are a workspace of their own, which cargo fmt --all never reaches.
  quietly "cd \"$staged\" && rustfmt --check --edition 2021 fuzz/fuzz_targets/*.rs" \
    "rustfmt would change the fuzz targets"
else
  echo "!  cargo is not here, so the formatting was not looked at"
fi

if [ -x node_modules/.bin/biome ]; then
  quietly "cd \"$staged/app\" && \"$PWD/node_modules/.bin/biome\" check src" \
    "biome would change files, or is not installed; it is the first thing CI runs"
else
  echo "!  biome is not installed (npm ci at the root), so it did not look at the window"
fi

# The rules job refuses a lockfile the notices do not follow; written here, the fix is one `git add` away.
if git diff --cached --name-only | grep -qE '(^|/)(Cargo\.lock|package-lock\.json)$'; then
  if [ -x node_modules/.bin/biome ]; then
    quietly "node scripts/third-party.mjs > /dev/null && git diff --quiet -- THIRD-PARTY-BUNDLED.md THIRD-PARTY-LICENSES.md" \
      "the notices were behind the lockfiles; npm run notices just wrote them, so stage them"
  else
    echo "!  the workspace is not installed (npm ci at the root), so the notices were not checked against the lockfiles"
  fi
fi

exit $status
