  ],
  "styles": {
    "color": {
      "pattern": "^#[0-9a-fA-F]{3,8}$"
    },
    "font-size": {
      "length": true
    },
    "font-variant-caps": {
      "pattern": "^small-caps$"
    },
    "margin-left": {
      "length": true,
      "negative": true
    },
    "math-shift": {
      "pattern": "^compact$"
    },
    "padding-left": {
      "length": true
    },
    "padding-right": {
      "length": true
    },
    "text-align": {
      "pattern": "^(left|center|right)$"
    },
    "width": {
      "length": true
    }
  },
  "lengths_at_most": {
    "px": 2000,
    "em": 20,
    "rem": 20,
    "ex": 40,
    "%": 300
  },
  "urls": {
    "schemes": [
      "http",
      "https",
      "mailto",
      "tisty"
    ],
    "relative": true,
    "protocol_relative": false
  },
  "picture_src": "^tisty:picture/[0-9]+$",
  "colour_fills": "^(none|currentColor|var\\(--tisty-[a-z-]+\\)|#[0-9a-fA-F]{3,8})$",
  "never": [
    "script",
    "style",
    "iframe",
    "object",
    "embed",
    "form",
    "input",
    "button",
    "meta",
    "base",
    "link",
    "foreignobject",
    "use",
    "image",
    "animate",
    "set"
  ],
  "never_attributes": [
    "on*",
    "srcdoc",
    "xlink:href",
    "aria-*",
    "data-* outside this list"
  ]
}
