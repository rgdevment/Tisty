{
  "globs": [
    "**/*.md",
    "!node_modules",
    "!target",
    "!app/node_modules",
    "!packages/*/node_modules",
    "!app/.stryker-tmp",
    "!app/reports",
    "!mutants.out",
    "!THIRD-PARTY-BUNDLED.md",
    "!THIRD-PARTY-LICENSES.md",
    "!crates/tisty-markdown/reference",
    "!docs/help"
  ],
  "config": {
    "default": true,
    "MD013": { "line_length": 80, "code_blocks": false, "tables": false },
    "MD014": false,
    "MD024": { "siblings_only": true },
    "MD033": {
      "allowed_elements": [
        "a",
        "br",
        "div",
        "h1",
        "h4",
        "img",
        "kbd",
        "mark",
        "p",
        "strong",
        "sub",
        "table",
        "td",
        "tr"
      ]
    },
    "MD041": false,
    "MD046": { "style": "fenced" },
    "MD060": false
  }
}
