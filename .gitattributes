# Line endings are normalised to LF in the repository. Without this, editing from
# both WSL2 and Windows fills every diff with whole-file changes.
* text=auto eol=lf

*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.json text eol=lf

# Signed bytes: a conversion that touches one of them is a signature that no longer answers.
fixtures/stores/** -text
crates/tisty-carrier/src/folio_signed/** -text

*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.pdf binary
*.mp3 binary
*.webm binary
*.mp4 binary

# Agent files as assistants leave them: their own endings are what a round trip must give back.
crates/tisty-core/src/agents/fixtures/** -text

# The dictionary ships as derived: a byte changed is a table whose sha256 no longer answers.
app/src-tauri/resources/brain/** -text
