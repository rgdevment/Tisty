source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Undo the last write to a document: a changed passage or a whole write is put back; appends and the person's saves keep nothing to undo. Refused if written since, unless `even_if_more`. Undoing twice returns it. Use it when a write answers something unexpected, instead of retyping.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "A document's id, not its title, or a task's to put back the assistant's notes on its page",
        "type": "string"
      },
      "even_if_more": {
        "description": "Go back over what was written since too; only once you read it and know, since the person may have written it",
        "type": "boolean"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "restore_doc",
  "title": "Put a document back the way it was"
}
