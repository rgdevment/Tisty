{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Unmark steps an agent ticked that are not done after all, on a task you filed or one the person opened to agents. On any other of the person's tasks it takes back your word on steps you said were done. Only a tick or a word an agent gave can be taken back: one the person gave is theirs, and naming it unticks nothing. Name each step by its text as `read` shows it. Unticking closes and opens nothing; the task stays as it was.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "step": {
        "description": "One step, by its text — the same as `steps` with one entry",
        "type": "string"
      },
      "steps": {
        "description": "The steps to untick, each by its text as `read` shows it — capitals, accents and the spaces at either end decide nothing. One of `steps` or `step` has to come with the call",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "task": {
        "description": "The task id",
        "type": "string"
      }
    },
    "required": [
      "task"
    ],
    "type": "object"
  },
  "name": "untick",
  "title": "Take back a tick given by mistake"
}
