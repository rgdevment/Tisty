---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Join a document to another's languages, or take it out of them. With `of`, `doc` joins them and moves to that document's folder; without, `doc` stands on its own again. To join, each says its language in a `lang:` property, or `lang` for `doc`; a language already there or a page is refused, saying why. A new translation is `write_doc` with `translation_of`.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "Id of the document to join or take out, not its title",
        "type": "string"
      },
      "lang": {
        "description": "The language of `doc`, like `es`, `en` or `pt-BR`, when its properties lack one",
        "type": "string"
      },
      "of": {
        "description": "Id of a document whose languages it joins. Left out, it leaves its own",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "tongue_doc",
  "title": "Join or leave a document's languages"
}
