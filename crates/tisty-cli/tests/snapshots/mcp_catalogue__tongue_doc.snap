---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "With `of`, join `doc` to that document's languages, moving it to its folder; without, take `doc` out of its languages. Both say their language in a `lang:` property, or `lang` for `doc`. A new translation is `write_doc` with `translation_of`.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "Id of the document to join or take out, not its title",
        "type": "string"
      },
      "lang": {
        "description": "The language of `doc`, like `es`, `en` or `pt-BR`, when its properties lack one",
        "type": "string"
      },
      "of": {
        "description": "Id of a document whose languages it joins. Left out, it leaves its own",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "tongue_doc",
  "title": "Join or leave a document's languages"
}
