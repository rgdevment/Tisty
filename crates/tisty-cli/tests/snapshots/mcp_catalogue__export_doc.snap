source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Write a document out as Markdown files in a folder on this machine, its pages numbered in reading order and its files beside them. A copy: nothing here changes. For another tool, `read_doc` with `as`.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "The document's id from `docs`, not its title",
        "type": "string"
      },
      "into": {
        "description": "An existing folder under Downloads, Documents, Pictures, Desktop or the temporary folder, not used for this document before",
        "type": "string"
      }
    },
    "required": [
      "doc",
      "into"
    ],
    "type": "object"
  },
  "name": "export_doc",
  "title": "Export a document to a folder"
}
