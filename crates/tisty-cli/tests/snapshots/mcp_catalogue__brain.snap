---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Search and walk the person's tasks and documents, archive included, without opening them. `query` ranks them by where the words turn up, then by how recent, each with its newest line saying them; when none has every word, those with the most come, said so. The other fields sift tasks. `doc` or `task` alone gives its card: a document's sections with `at`, lines and the `print` `edit_doc` needs, a task's state, steps and parts, and what cites each; `links` brings its neighbours of one kind; `doc` with `query`, its lines. `part_of` alone groups a project's open parts: blocked, under way, waiting on the person, not started. `folder` or `scope` alone lists documents; nothing at all, the lists, folders and tags with their counts. Answers are capped and `next` says how to go on. The text itself is `read` for a task, `read_doc` for a document.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "after": {
        "description": "Skip this many, to page on while `total` is higher",
        "type": "integer"
      },
      "around": {
        "description": "With `doc` and `query`: lines each side of a hit, 0 to 10, 1 by default",
        "type": "integer"
      },
      "by_agent": {
        "description": "True: filed by an agent; false: by the person",
        "type": "boolean"
      },
      "doc": {
        "description": "A document's id: its card; with `query`, the lines that say it, their numbers and section",
        "type": "string"
      },
      "folder": {
        "description": "Documents in this folder or below, by name, path or id",
        "type": "string"
      },
      "from": {
        "description": "Date or deadline on or after this day (2026-08-31)",
        "type": "string"
      },
      "from_source": {
        "description": "Tasks whose `source` starts with this, however written: «sereno» brings all read from there",
        "type": "string"
      },
      "limit": {
        "description": "10 by default and 100 at most; 50 by default for a folder's documents or a project's parts",
        "type": "integer"
      },
      "lines": {
        "description": "False: titles alone, without their line",
        "type": "boolean"
      },
      "links": {
        "description": "With `doc` or `task`: its neighbours of this kind, each with title and state",
        "enum": [
          "cite",
          "mention",
          "structure",
          "tag",
          "uses",
          "all"
        ],
        "type": "string"
      },
      "list": {
        "description": "In this list, as `catch_up` names it",
        "type": "string"
      },
      "part_of": {
        "description": "The parts of this task, by id",
        "type": "string"
      },
      "query": {
        "description": "Words, in any order, accents or not; quote a phrase. Not needed when sifting",
        "type": "string"
      },
      "said_done": {
        "description": "True: an agent said done or not doing and the person has not decided; false: nobody did",
        "type": "boolean"
      },
      "scope": {
        "description": "Defaults to either",
        "enum": [
          "open",
          "archive",
          "either"
        ],
        "type": "string"
      },
      "section": {
        "description": "With `doc`: the headings under this `at`, for an outline that came cut",
        "type": "integer"
      },
      "source": {
        "description": "Whether this exact source was filed already; not with `query`",
        "type": "string"
      },
      "tag": {
        "description": "Carrying this tag, # or not. Any sifting field leaves documents out",
        "type": "string"
      },
      "task": {
        "description": "A task's id: its card",
        "type": "string"
      },
      "to": {
        "description": "Date or deadline on or before this day",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "brain",
  "title": "Find anything kept and see how it connects"
}
