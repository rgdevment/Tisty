{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Move documents into a folder, or out of every folder by leaving `folder` out. Only the place changes; an archived document moves and stays put away.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        ],
        "description": "The id of the document to file, not its title, or a list of ids: if one cannot, none moves"
      },
      "folder": {
        "description": "An existing folder, by name, path or id",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "file_doc",
  "title": "Put documents in a folder"
}
