{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Leave the next agent a `summary` and `notes` on a document, replacing the last; they reach the person's other computers, unseen by the person, and go stale when it is written. Write them after reading it, never instead.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "The document's id from `brain`, not its title",
        "type": "string"
      },
      "notes": {
        "description": "What working with it needs: which section holds what, what is stale or missing",
        "type": "string"
      },
      "summary": {
        "description": "What it says and what a reader comes to it for, in a few lines",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "sum_up",
  "title": "Say what a document is about"
}
