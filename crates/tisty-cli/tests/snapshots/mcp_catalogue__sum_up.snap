{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Leave a `summary` and `notes` on a document for the next agent, kept on this machine only and unseen by the person; a later write marks it stale. Write it after reading a long document, never instead, saying what it says.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "The document's id from `docs`, not its title",
        "type": "string"
      },
      "notes": {
        "description": "What working with it needs: which section holds what, what is stale or missing",
        "type": "string"
      },
      "summary": {
        "description": "What it says and what a reader comes to it for, in a few lines",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "sum_up",
  "title": "Say what a document is about"
}
