---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Read or change one table of a document by rows and columns, never its Markdown; without `do` it only shows the table. A row is named by its first cell, a column by its title, as `show` gives them. Values are written as the column's type reads them (1234.5, 2026-10-28, true); one that does not fit is kept and named. Undone like `edit_doc`.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "column": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "For set, sort, type, rename and remove_column: its title, or its number from 1"
      },
      "do": {
        "description": "Defaults to show: the columns with their types and the rows, changing nothing",
        "enum": [
          "show",
          "set",
          "add",
          "remove",
          "sort",
          "type",
          "rename",
          "add_column",
          "remove_column"
        ],
        "type": "string"
      },
      "doc": {
        "description": "The document's id from `docs`, not its title",
        "type": "string"
      },
      "down": {
        "description": "For sort: largest first",
        "type": "boolean"
      },
      "keep_compaction": {
        "description": "Only on the person's word: `rules` «tidying»",
        "type": "boolean"
      },
      "row": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "For set and remove: its first cell's words, or its number from 1"
      },
      "table": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "description": "Its number from 1, or the heading over it. Left out when there is one"
      },
      "title": {
        "description": "For rename and add_column: the column's title",
        "type": "string"
      },
      "type": {
        "description": "For type and add_column: as written in braces in its head, like `number`, `money USD sum`, `date`, `check` (`language` «tables»); empty removes it",
        "type": "string"
      },
      "value": {
        "description": "For set: what goes in the cell; empty clears it",
        "type": "string"
      },
      "values": {
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "description": "For add: each column's title with its value; columns left out stay empty",
        "type": "object"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "edit_table",
  "title": "Change a table in a document"
}
