---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Add at a document's end, or under the heading in `under`, without reading it or a `print`; nothing written changes. For logs, minutes and dated notes; a changed fact is `edit_doc`. The answer says how much it `grew`. A task's id in `doc`, on a task you may work on, adds under the assistant's notes on its page, dated and signed.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "description": "Markdown to add, after a blank line",
        "type": "string"
      },
      "doc": {
        "description": "A document's id, not its title, or a task's to add to its page",
        "type": "string"
      },
      "echo": {
        "description": "Hand back the lines around the change, instead of reading again",
        "type": "boolean"
      },
      "keep_compaction": {
        "description": "Only on the person's word: `rules` «tidying»",
        "type": "boolean"
      },
      "replace": {
        "description": "Only with a task's id: rewrite the assistant's notes on its page whole, as one dated digest; a box in it is no step",
        "type": "boolean"
      },
      "under": {
        "description": "A heading, as it reads: adds at the end of what it holds. Left out, at the end of the document",
        "type": "string"
      }
    },
    "required": [
      "doc",
      "body"
    ],
    "type": "object"
  },
  "name": "append_doc",
  "title": "Add to a document, or to a task's page"
}
