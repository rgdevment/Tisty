  },
  "description": "Say that a task will not be done — it no longer matters, something else made it moot — on any task, the person's too, since it is only your word. Unticked steps do not stop it. It drops nothing: the task stays open, marked, until the person drops it or takes the mark off. Say it once; what is new after that goes in `note`.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "description": "The account the person reads before deciding: why it should not be done, and what you found that says so. In the Tisty language",
        "type": "string"
      },
      "task": {
        "description": "The task's id, as `find` or `propose` gave it",
        "type": "string"
      }
    },
    "required": [
      "task",
      "body"
    ],
    "type": "object"
  },
  "name": "say_not_doing",
  "title": "Say a task should not be done"
}
