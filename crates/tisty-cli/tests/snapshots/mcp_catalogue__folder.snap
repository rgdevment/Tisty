---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Make a folder for documents (tasks go in lists), with an icon and colour if they fit. A name in use hands back that folder, found at any depth unless `inside` says where; an icon or colour sent restyles it.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "color": {
        "description": "red, orange, amber, green, teal, blue, indigo, purple, pink, brown or gray",
        "type": "string"
      },
      "icon": {
        "description": "One emoji, or a drawn name: home, work, money, study, travel, health, food, family, code and the like",
        "type": "string"
      },
      "inside": {
        "description": "An existing folder to nest it in, by name, path or id; four deep at most",
        "type": "string"
      },
      "name": {
        "description": "Its own name, a word or two, at most 40 characters; a path only to say where to nest it, every step but the last existing",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  },
  "name": "folder",
  "title": "Make a folder"
}
