        "description": "The task id",
        "type": "string"
      },
      "text": {
        "description": "What the step says now, at most 100 characters",
        "type": "string"
      }
    },
    "required": [
      "task",
      "step",
      "text"
    ],
    "type": "object"
  },
  "name": "reword_step",
  "title": "Rewrite an open step"
}
