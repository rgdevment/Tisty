---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "The documents, newest first, with each one's folder, whether it is put away or locked, and what it holds (words, sections, key words): enough to pick one unopened. A task's words come with the task. Ask before writing, so nothing is kept twice.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "after": {
        "description": "Skip this many, to page on while `total` is higher",
        "type": "integer"
      },
      "deep": {
        "description": "With `folder`: the folders below it too",
        "type": "boolean"
      },
      "folder": {
        "description": "Only the documents in this folder, by name, path or id, without pages; the folders below are named under `below`",
        "type": "string"
      },
      "folders": {
        "description": "Every folder too, with id, path, icon and size; the text already names them",
        "type": "boolean"
      },
      "limit": {
        "description": "At most 200, 50 by default",
        "type": "integer"
      },
      "page_of": {
        "description": "Only the pages of this document, by id, in reading order",
        "type": "string"
      },
      "scope": {
        "description": "Defaults to either",
        "enum": [
          "open",
          "archive",
          "either"
        ],
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "docs",
  "title": "The documents and the folders"
}
