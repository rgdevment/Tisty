---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Mark what had its day, or «delete this document»: the person deletes it, puts it away or unmarks it. Give the `reason`, `instead` where its content lives now, and `body`. Copies go in one call: one click deletes or unmarks them all. A document already marked is refused, or skipped in a set.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "description": "In the person's language: what makes it old, and how you know",
        "type": "string"
      },
      "doc": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        ],
        "description": "The id of the document to mark, not its title, or `sheet#heading` for an idea; a list is marked alike"
      },
      "instead": {
        "description": "Id of the document or task that holds it now; needed with duplicate_of, moved and superseded",
        "type": "string"
      },
      "reason": {
        "description": "A copy of another, moved into another (only once what it held worth keeping is there), superseded by another, wrong, obsolete, or a scratch nobody needs",
        "enum": [
          "duplicate_of",
          "moved",
          "superseded",
          "wrong",
          "obsolete",
          "scratch"
        ],
        "type": "string"
      }
    },
    "required": [
      "doc",
      "body"
    ],
    "type": "object"
  },
  "name": "flag_doc",
  "title": "Mark a document that had its day"
}
