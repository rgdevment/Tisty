        "enum": [
          "en",
          "es"
        ],
        "type": "string"
      },
      "topic": {
        "description": "One page, named as the index names it. Left out, the index",
        "enum": [
          "index",
          "installation",
          "keyboard-shortcuts",
          "tasks",
          "natural-language",
          "spread-and-reminders",
          "archive",
