---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Search open and archived tasks and documents: words in `query`, the task fields below to sift, `source` to see if something was filed, `doc` for lines inside one document. A task matched in its page, steps or notes brings the `line`. Open a task hit with `read`, a document hit with `read_doc`.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "after": {
        "description": "Skip this many tasks, to page on while `total` is higher. Documents are not paged: `docsTotal` counts them",
        "type": "integer"
      },
      "around": {
        "description": "With `doc`: lines each side of a hit, 0 to 10, 1 by default",
        "type": "integer"
      },
      "by_agent": {
        "description": "True: filed by an agent; false: by the person",
        "type": "boolean"
      },
      "doc": {
        "description": "Search inside this document: lines with every word, their numbers, neighbours cut at 200 characters, and section",
        "type": "string"
      },
      "folder": {
        "description": "Only documents in this folder or below, by name, path or id",
        "type": "string"
      },
      "from": {
        "description": "Date or deadline on or after this day (2026-08-31)",
        "type": "string"
      },
      "from_source": {
        "description": "Tasks whose `source` starts with this, however written: «sereno» brings all read from there",
        "type": "string"
      },
      "limit": {
        "description": "At most 100, 20 by default",
        "type": "integer"
      },
      "list": {
        "description": "In this list, as `lists` names it",
        "type": "string"
      },
      "open_to_agents": {
        "description": "True: the person's tasks opened to agents; false: kept to themselves",
        "type": "boolean"
      },
      "part_of": {
        "description": "Only the parts of this task, by id",
        "type": "string"
      },
      "query": {
        "description": "Words that must all turn up, in any order, accents or not (with `doc`, on one line); quote a phrase. Not needed when sifting",
        "type": "string"
      },
      "said_done": {
        "description": "True: an agent said done or not doing and the person has not decided; false: nobody did",
        "type": "boolean"
      },
      "scope": {
        "description": "Defaults to either: open and archived together",
        "enum": [
          "open",
          "archive",
          "either"
        ],
        "type": "string"
      },
      "source": {
        "description": "Whether this exact source was filed already; not with `query`",
        "type": "string"
      },
      "tag": {
        "description": "Carrying this tag, # or not. Any sifting field leaves documents out",
        "type": "string"
      },
      "to": {
        "description": "Date or deadline on or before this day",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "find",
  "title": "Search the list and the archive"
}
