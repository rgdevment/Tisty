---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Hang a document under another as a page, or with no `page_of` take a page back out to its old folder. A page goes everywhere with its document. Hanging writes the line naming it at the document's end, or where `after`, `before` or `at` say; taking out leaves the line for you to remove. `order` reorders a document's pages. Reading order is line order, each line `![Its title](tisty:doc/its-id)`, bang included.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "after": {
        "description": "Id of another page of that document, whose line this one's goes right after. Needs `page_of` and one `doc`, and that page needs a line",
        "type": "string"
      },
      "at": {
        "description": "Before or after every page line, for when there is no page to name",
        "enum": [
          "first",
          "last"
        ],
        "type": "string"
      },
      "before": {
        "description": "The same, right before",
        "type": "string"
      },
      "doc": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        ],
        "description": "The id of the document to hang or take out, not its title, or a list of ids: if one cannot, none moves"
      },
      "order": {
        "description": "Its pages' ids, two or more, each once, in reading order: their lines trade places, nothing else moves. With `page_of` alone; each needs a line",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "page_of": {
        "description": "Id of the document it becomes a page of. Left out, it becomes a document of its own",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "page_doc",
  "title": "Make pages, put them in order, or take one out"
}
