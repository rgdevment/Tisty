{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Copy a file from this machine into Tisty: with `task` onto its journal, with `doc` at the end of that document as a picture or a card. Up to 650 MB; an HTML page is kept, never run. Attach only what you were asked to.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "The document's id, to add it there",
        "type": "string"
      },
      "label": {
        "description": "What to call it; defaults to the file's name",
        "type": "string"
      },
      "path": {
        "description": "A file under Downloads, Documents, Pictures, Desktop or the temporary folder",
        "type": "string"
      },
      "task": {
        "description": "The task id, to keep it with a task",
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "type": "object"
  },
  "name": "attach",
  "title": "Attach a file to a task or a document"
}
