              "description": "List name",
              "type": "string"
            },
            "priority": {
              "description": "Priority",
              "enum": [
                "do",
                "decide",
                "delegate",
                "minor"
              ],
              "type": "string"
            },
            "remind": {
              "description": "Ring ISO times",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "source": {
              "description": "Origin ID/URL",
              "type": "string"
            },
            "steps": {
              "description": "Steps (<=100 chars)",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tags": {
              "description": "Tags",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "description": "Title (<=500 chars)",
              "type": "string"
            }
          },
          "required": [
            "title"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "priority": {
        "description": "Eisenhower priority (only if explicitly requested)",
        "enum": [
          "do",
          "decide",
          "delegate",
          "minor"
        ],
        "type": "string"
      },
      "remind": {
        "description": "One-off ring times (YYYY-MM-DDTHH:MM, <=32); evening before for fixed-hour events",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "source": {
        "description": "Origin ID/URL for deduplication; idea name removes it from Ideas",
        "type": "string"
      },
      "steps": {
