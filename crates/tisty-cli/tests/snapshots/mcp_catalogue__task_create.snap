{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Create actionable task(s); lasting reference belongs in `doc_create`. Every task requires single owner `for` (\"agent\" or \"person\"). Pass `source` to deduplicate; `parts` creates subtasks (1 level, <=32). Batch up to 32 via `tasks` alone. Tagged #agent.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "again": {
        "description": "Allow re-filing from a closed/dropped `source` only when user asks to redo",
        "type": "boolean"
      },
      "date": {
        "description": "Planned day (YYYY-MM-DD), or start day when `deadline` is set",
        "type": "string"
      },
      "deadline": {
        "description": "Hard due date (YYYY-MM-DD); only past deadlines become overdue",
        "type": "string"
      },
      "description": {
        "description": "Task details in Tisty Markdown (<=64,000 chars)",
        "type": "string"
      },
      "for": {
        "description": "Required single owner: \"agent\" (you do/verify) or \"person\" (only they can)",
        "enum": [
          "agent",
          "person"
        ],
        "type": "string"
      },
      "list": {
        "description": "Existing list name (from workspace_catch_up); omit for inbox only with reason",
        "type": "string"
      },
      "part_of": {
        "description": "Open parent task ID to attach this task as a subtask",
        "type": "string"
      },
      "parts": {
        "description": "Up to 32 subtasks (`for` inherits parent if omitted; 1 level only)",
        "items": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "description": "Day ISO",
              "type": "string"
            },
            "deadline": {
              "description": "Due ISO",
              "type": "string"
            },
            "description": {
