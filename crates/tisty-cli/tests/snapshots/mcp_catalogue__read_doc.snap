---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "A document's text and the `print` it reads at. Past about 12,000 characters it comes back as its outline (`whole` false): then ask for a `section`, lines, or `chars` at a time. Every part brings the print, so `edit_doc` needs no whole read. `pages_loose` names pages no line places.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "as": {
        "description": "The whole document in GitHub Markdown for another tool; tell the person what `left_out` lists (`rules` «documents»). Not with `section`, lines or `chars`",
        "enum": [
          "markdown"
        ],
        "type": "string"
      },
      "chars": {
        "description": "About how many characters to bring; the answer gives `next` when there is more",
        "type": "integer"
      },
      "cursor": {
        "description": "The `next` a previous answer gave, with `chars`",
        "type": "integer"
      },
      "doc": {
        "description": "The document's id from `docs`, not its title",
        "type": "string"
      },
      "from": {
        "description": "First line, from 1",
        "type": "integer"
      },
      "print": {
        "description": "The `print` the previous part came with; only with `cursor`",
        "type": "string"
      },
      "section": {
        "description": "A heading and all under it, by its `at` in `outline_doc`, from 0",
        "type": "integer"
      },
      "to": {
        "description": "Last line; left out, to the end",
        "type": "integer"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "read_doc",
  "title": "Read a document, or a part of one"
}
