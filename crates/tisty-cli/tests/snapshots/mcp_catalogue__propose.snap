---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Propose a task, something to do; what is kept to read again is `write_doc`. Several from one thread go in `tasks`, each judged alone. Work of several tasks with one end goes in `parts`, not packed into steps. An idea named as `source` leaves Brainstorm. Tisty tags it #agent.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "again": {
        "description": "Only when the person asks in this conversation to redo what was filed from this source and closed since, never for one still open; say in the description how the last one ended",
        "type": "boolean"
      },
      "date": {
        "description": "The day it is meant to be done, or with a deadline the day work starts (2026-08-31)",
        "type": "string"
      },
      "deadline": {
        "description": "The day it truly runs out (2026-08-31); only then is it overdue",
        "type": "string"
      },
      "description": {
        "description": "What you read, in the Tisty language",
        "type": "string"
      },
      "list": {
        "description": "An existing list, by name, as `catch_up` names it. Left out, it lands in the inbox, which needs a reason",
        "type": "string"
      },
      "part_of": {
        "description": "Id of an open task this one is a part of",
        "type": "string"
      },
      "parts": {
        "description": "Its parts, each shaped like a single task with its own steps: one level, at most 32 here, more later with `part_of`",
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "priority": {
        "description": "Only if someone said so",
        "enum": [
          "do",
          "decide",
          "delegate",
          "minor"
        ],
        "type": "string"
      },
      "remind": {
        "description": "When to ring, like 2026-08-30T20:00: only for a one-off at a set hour that cannot be caught up on, the evening before",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "source": {
        "description": "Where you read it: a message id, a thread link",
        "type": "string"
      },
      "steps": {
        "description": "A checklist, each step at most 100 characters; what needs more is a part",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "tags": {
        "description": "Its subjects, one plain word each, reusing the tags `catch_up` shows; six is already a lot",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "tasks": {
        "description": "Several tasks, each shaped like a single one, at most 32; left out for one",
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "title": {
        "description": "What has to be done, in a line",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "propose",
  "title": "Propose a task"
}
