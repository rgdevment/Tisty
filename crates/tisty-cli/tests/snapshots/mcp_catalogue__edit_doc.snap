---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Replace one passage of a document, named by its text in `old` or by place with `section` or `from` and `to`, which needs no reading of the rest. What it said is kept first for `restore_doc`, or the edit is refused. The answer's `grew` should be close to what you sent.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "The document's id from `docs`, not its title",
        "type": "string"
      },
      "echo": {
        "description": "Hand back the lines around the change, instead of reading again",
        "type": "boolean"
      },
      "from": {
        "description": "First line to replace, from 1. Needs `print`",
        "type": "integer"
      },
      "keep_compaction": {
        "description": "Only on the person's word: `rules` «tidying»",
        "type": "boolean"
      },
      "new": {
        "description": "What takes its place; empty takes the passage out",
        "type": "string"
      },
      "old": {
        "description": "The passage as written now, from `read_doc`, matching one place only; take in a line around it if needed. Not with `section` or lines",
        "type": "string"
      },
      "print": {
        "description": "The `print` from `read_doc` or `outline_doc`, for `section` or lines only. If anyone wrote since, nothing changes: ask `outline_doc` again",
        "type": "string"
      },
      "section": {
        "description": "A heading and all under it, by its `at` in the `outline` of `outline_doc`, from 0. Needs `print`",
        "type": "integer"
      },
      "to": {
        "description": "Last line; left out, to the end. Only with `from`",
        "type": "integer"
      }
    },
    "required": [
      "doc",
      "new"
    ],
    "type": "object"
  },
  "name": "edit_doc",
  "title": "Change a passage of a document"
}
