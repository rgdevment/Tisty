          "type": "string"
        },
        "type": "array"
      },
      "notes": {
        "description": "How many latest notes, cut at 4000 chars; 0: all, whole",
        "type": "integer"
      },
      "task": {
        "description": "The task id",
        "type": "string"
      }
    },
    "required": [
      "task"
    ],
    "type": "object"
  },
  "name": "read",
  "title": "Read a whole task"
