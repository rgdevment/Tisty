---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Write a document, something kept and read again; work to do is `propose`. Markdown is turned into the Tisty language and `turned` says what changed. Alone it writes a new one: `find` first, as a subject with a document is updated there, and a title in use is refused. With `doc` and `print` it rewrites that one whole, page lines the body drops going back at the end; one passage is `edit_doc`. #words in its text tag it.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "anyway": {
        "description": "Write it although a document names the same subject; only when it truly is another",
        "type": "boolean"
      },
      "body": {
        "description": "The whole document; its first line is its title. One line per paragraph: a single newline is a line break, so wrapped text reads broken",
        "type": "string"
      },
      "compact": {
        "description": "With `doc` and `print`: this write puts the document back in order, as `rules` «tidying» says. Refused on one the person began unless `person_asked`",
        "type": "boolean"
      },
      "doc": {
        "description": "Id of a document to write again whole, not its title; needs `print`. Left out, a new one",
        "type": "string"
      },
      "folder": {
        "description": "The existing folder its subject belongs in, by name, path or id; left out needs a reason. Not with `doc`: `file_doc` moves one",
        "type": "string"
      },
      "keep_compaction": {
        "description": "The person told you in this conversation to keep the compaction awaiting their word",
        "type": "boolean"
      },
      "lang": {
        "description": "With `translation_of`: the body's language tag, like `es`, `en` or `pt-BR`",
        "type": "string"
      },
      "page_of": {
        "description": "Id of the document this is a page of: it is named at that document's end (`page_doc` moves the line), takes its folder and holds no pages",
        "type": "string"
      },
      "person_asked": {
        "description": "With `compact`: the person asked you in this conversation to compact a document they began",
        "type": "boolean"
      },
      "print": {
        "description": "The `print` `read_doc` gave with the text you worked from; if the document changed since, nothing is written",
        "type": "string"
      },
      "translation_of": {
        "description": "Id of a document this one says in another language, joined as one more of its languages; both say their language, in `lang` or a `lang:` property",
        "type": "string"
      }
    },
    "required": [
      "body"
    ],
    "type": "object"
  },
  "name": "write_doc",
  "title": "Write a document"
}
