        "description": "An existing list, by name, as `catch_up` names it, for a task an agent filed",
        "type": "string"
      },
      "part_of": {
        "description": "Id of the task to hang it under, or null to let it go",
        "type": [
          "string",
          "null"
        ]
      },
      "task": {
        "description": "The task id",
        "type": "string"
      }
    },
    "required": [
      "task"
    ],
    "type": "object"
  },
  "name": "move",
  "title": "Hang a task under another, or move it to a list"
}
