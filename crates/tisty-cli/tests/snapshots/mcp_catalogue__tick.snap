{
  "description": "Mark steps of a task done when you did them yourself — the moment you did, not at the end. Name each by its text as `read` shows it; one unknown name and nothing is ticked, and a name two steps share ticks the next one still open. On a task you filed or one the person opened to agents the step is ticked; on any other of the person's it stays unticked, said done, until they take your word. Either way the task stays open until `say_done` and the person.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "step": {
        "description": "One step, by its text — the same as `steps` with one entry",
        "type": "string"
      },
      "steps": {
        "description": "The steps you did, each by its text as `read` shows it — capitals, accents and the spaces at either end decide nothing. One of `steps` or `step` has to come with the call",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "task": {
        "description": "The task id",
        "type": "string"
      }
    },
    "required": [
      "task"
    ],
    "type": "object"
  },
  "name": "tick",
  "title": "Tick the steps you did"
}
