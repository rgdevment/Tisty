{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Put a document or one page away when the person asks, or bring it back with `archived` false; nothing is deleted or changed («delete it» is `flag_doc`). A page put away stays under its document, read-only; a document's pages go and come back with it.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "archived": {
        "description": "True, the default, puts it away; false brings it back",
        "type": "boolean"
      },
      "doc": {
        "description": "The document's id from `docs`, not its title",
        "type": "string"
      },
      "folder": {
        "description": "A folder to file it in on the way, by name, path or id",
        "type": "string"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  },
  "name": "archive_doc",
  "title": "Put a document away, or bring it back"
}
