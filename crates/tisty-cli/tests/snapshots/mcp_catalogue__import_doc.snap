---
source: crates/tisty-cli/tests/mcp_catalogue.rs
expression: tool
---
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Bring one Markdown file from disk in as a document, turned into the Tisty language, saying what changed. Files it points at come in too; links to what cannot are taken out. The file on disk is untouched; a seeming live credential comes in under a warning. A task's exported page goes back to its task. One file per call.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "anyway": {
        "description": "Bring it in although a document has the same subject; only when it truly is another",
        "type": "boolean"
      },
      "folder": {
        "description": "The existing folder its subject belongs in, by name, path or id. Left out needs a reason",
        "type": "string"
      },
      "page_of": {
        "description": "Id of the document it becomes a page of",
        "type": "string"
      },
      "path": {
        "description": "A Markdown file under Downloads, Documents, Pictures, Desktop or the temporary folder",
        "type": "string"
      },
      "title": {
        "description": "A title for a file whose first line is not one; defaults to the file name",
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "type": "object"
  },
  "name": "import_doc",
  "title": "Bring a Markdown file in as a document"
}
