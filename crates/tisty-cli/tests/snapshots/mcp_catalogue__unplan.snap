{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Take unticked steps off an open task. With `to` they are handed on, after that task's own steps, instead of dropped. One ticked step among them and nothing changes.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "step": {
        "description": "One step, by its text",
        "type": "string"
      },
      "steps": {
        "description": "The steps to take off, by their text as `read` shows it; case and accents do not matter",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "task": {
        "description": "The task id",
        "type": "string"
      },
      "to": {
        "description": "Id of another open task, not said done, to hand them to",
        "type": "string"
      }
    },
    "required": [
      "task"
    ],
    "type": "object"
  },
  "name": "unplan",
  "title": "Take open steps off a task"
}
