    "additionalProperties": false,
    "properties": {
      "body": {
        "description": "What you did and what makes you sure (the command and its answer, the commit), in the Tisty language",
        "type": "string"
      },
      "task": {
        "description": "The task id",
        "type": "string"
      }
    },
    "required": [
      "task",
      "body"
    ],
    "type": "object"
  },
  "name": "say_done",
  "title": "Say a task is finished"
}
