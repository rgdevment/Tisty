{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "tisty-diagrams/*": ["../packages/tisty-diagrams/src/*"],
      "tisty-editor/*": ["../packages/tisty-editor/src/*"]
    }
  },
  "include": [
    "src",
    "../packages/tisty-diagrams/src",
    "../packages/tisty-diagrams/tests",
    "../packages/tisty-editor/src",
    "../packages/tisty-editor/tests"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
