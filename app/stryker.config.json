{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "coverageAnalysis": "perTest",
  "reporters": [
    "progress",
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutants.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutants.json"
  },
  "inPlace": false,
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    "src-tauri/target",
    "dist",
    "coverage",
    "reports"
  ],
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.d.ts",
    "!src/tests/**",
    "!src/main.tsx",
    "!src/marks.ts",
    "!src/glyphs.ts",
    "!src/locales.ts",
    "!src/synonyms.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
