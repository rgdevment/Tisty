{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tisty",
  "version": "0.1.0",
  "identifier": "dev.rgdevment.tisty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tisty",
        "width": 1100,
        "height": 720,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "quick",
        "title": "Tisty",
        "width": 620,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421 http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "rgdevment",
    "copyright": "Copyright © 2026 rgdevment",
    "category": "Productivity",
    "shortDescription": "Local, private task manager whose archive is the point",
    "longDescription": "Tisty keeps your tasks on your own machine, in plain files you can read without it. No account, no telemetry, no server. Sync, if you want it, goes through a folder both your machines already reach.",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/tisty"
    ]
  }
}
