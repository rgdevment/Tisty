<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled in by .github/workflows/release.yml: @IDENTITY@, @PUBLISHER@,
  @PUBLISHER_DISPLAY@ and @VERSION@ come from Partner Center and the tag.

  @VERSION@ is always four numbers ending in 0. MSIX has no room for a
  prerelease suffix, so `0.1.0-rc3` and `0.1.0` would both become `0.1.0.0` —
  which is one more reason nothing but a final tag reaches the Store.

  This package is never signed here. The Store signs it on publication, which
  is what makes its identity mean anything.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 uap10 desktop rescap">

  <Identity
    Name="@IDENTITY@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Tisty</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Local, private task manager whose archive is the point</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es" />
  </Resources>

  <Applications>
    <Application Id="Tisty" Executable="Tisty.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Tisty"
        Description="Local, private task manager whose archive is the point"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- No wide tile: Square310x310Logo would demand a Wide310x150Logo
             that this icon set does not have. -->
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>

      <!--
        Without this the package installs into a container and `tisty` does not
        exist in any terminal — the window would ship with its command line
        amputated. `cli\` because Windows filenames are case-insensitive and
        `tisty.exe` cannot sit beside `Tisty.exe`.
      -->
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="cli\tisty.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="tisty.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>

        <!--
          A packaged app writes the Run key into its own container, where
          Windows never looks: this is the only startup switch the Store
          honours. The app flips it through StartupTask, off until asked.
        -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="Tisty.exe"
          EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--hushed">
          <uap5:StartupTask TaskId="Tisty" Enabled="false" DisplayName="Tisty" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
