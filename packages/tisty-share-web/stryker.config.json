{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "tsconfigFile": "tsconfig.none.json",
  "vitest": {
    "configFile": "vite.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "dryRunTimeoutMinutes": 20,
  "reporters": ["progress", "clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutants.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutants.json"
  },
  "inPlace": false,
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["reports", "dist", "wasm"],
  "mutate": ["src/**/*.ts", "!src/**/*.d.ts", "!src/main.ts"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
