{
  "name": "tisty-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Tisty's own sheet, the one the app shows and edits. Its read door wraps a document drawn by tisty-sheet in its page, in the theme its host gives, and lays its sheets; its edit door puts editing over that same sheet.",
  "type": "module",
  "exports": {
    "./read": "./src/read.ts",
    "./edit": "./src/edit.ts",
    "./tokens.css": "./src/tokens.css",
    "./side.css": "./src/side.css"
  },
  "dependencies": {
    "tisty-sheet": "file:../tisty-sheet"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "*",
    "@codemirror/commands": "*",
    "@codemirror/lang-markdown": "*",
    "@codemirror/language": "*",
    "@codemirror/state": "*",
    "@codemirror/view": "*",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "*",
    "@lezer/markdown": "*"
  },
  "devDependencies": {
    "@tisty/contracts": "file:../../contracts/dist/typescript",
    "jsdom": "*",
    "vitest": "*"
  }
}
