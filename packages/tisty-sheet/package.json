{
  "name": "tisty-sheet",
  "private": true,
  "version": "0.1.0",
  "description": "What draws a document on its sheet, shared by Tisty's reader and the light viewer: the page's look and colours, and its code colours, diagrams, icons, tables and cards.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./glyphs": "./src/glyphs.ts",
    "./tokens.css": "./src/tokens.css",
    "./page.css": "./src/page.css",
    "./callouts.css": "./src/callouts.css",
    "./code.css": "./src/code.css",
    "./diagrams.css": "./src/diagrams.css",
    "./tables.css": "./src/tables.css",
    "./lively": "./src/lively.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tisty/contracts": "file:../../contracts/dist/typescript",
    "tisty-diagrams": "file:../tisty-diagrams"
  },
  "peerDependencies": {
    "lowlight": "*",
    "mermaid": "*"
  },
  "devDependencies": {
    "jsdom": "*",
    "vitest": "*"
  }
}
